# secrets — never commit
.env
.env.*
*.key
*.pem
# the relayer reads these from its own directory on the VPS; none may ever reach git
relayer/hotkey
relayer/hotkey*
relayer/qn_rpc
relayer/zerox_key
relayer/ip_salt
relayer/*.db
relayer/*.db-*

# foundry
cache/
out/
# Deployment records ARE tracked (run-latest.json: tx hashes, receipts, no secrets - those go to
# cache/). A `broadcast/` + `!.../run-latest.json` pair never worked: git cannot re-include a file
# whose parent directory is excluded. Ignore only the dry runs and the timestamped duplicates.
broadcast/**/dry-run/
broadcast/**/run-[0-9]*.json

# node
node_modules/
# package-lock.json is COMMITTED on purpose: this code signs next to a funded
# key, so the crypto dependency is pinned, not floating.

# local recon artifacts
docs/*.raw.json
.DS_Store
qn_rpc
*_rpc

# private security findings - never committed
docs/FINDINGS.md
docs/DISCLOSURE*.md

# fuzzing artifacts (independent review)
corpus/
crytic-export/

# tool output
slither_results.json
crytic-export/

# local preview config (points at scratch paths)
.claude/launch.json

# build output and tooling environments - never source, and 950 MB of history until 2026-09-27
stylus/**/target/
.venv*/
crytic-export/
